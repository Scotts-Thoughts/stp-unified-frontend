{
  "name": "stp-overlay",
  "version": "3.1.0",
  "description": "Scott's Thoughts Overlay.",
  "main": "./out/main/index.js",
  "build": {
    "electronLanguages": "en-US",
    "compression": "normal",
    "appId": "com.scottsthoughts.stp-overlay",
    "asar": false,
    "files": [
      "out/**",
      "!out/renderer/images",
      "!out/renderer/images/**"
    ],
    "extraFiles": [
      "storage/**",
      "resources/**",
      "!resources/keyhook.exe"
    ],
    "extraResources": [
      {
        "from": "src/renderer/public/images",
        "to": "images"
      }
    ],
    "afterPack": "./tools/build/after-pack.mjs",
    "productName": "stp-overlay",
    "linux": {
      "target": "AppImage"
    },
    "win": {
      "executableName": "stp-overlay",
      "target": "zip",
      "icon": "./icon.png"
    },
    "npmRebuild": false
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron .",
    "preview": "electron-vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "build": "electron-vite build",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "parity:selftest": "tsx tools/parity/mock-pokeabyte/selftest.ts",
    "parity:gamehook": "tsx tools/parity/mock-gamehook/selftest.ts",
    "parity:bookmarks": "tsx --tsconfig tsconfig.web.json tools/parity/bookmarks-selftest.ts",
    "parity:replay-splits": "tsx --tsconfig tsconfig.web.json tools/parity/replay-splits-selftest.ts",
    "parity:ohko": "tsx tools/parity/ohko-selftest.ts",
    "parity:speed": "tsx tools/parity/battle-speed-selftest.ts",
    "parity:accuracy": "tsx tools/parity/accuracy-selftest.ts",
    "parity:move-power": "tsx tools/parity/move-power-selftest.ts",
    "parity:send-order": "tsx tools/parity/send-out-order-selftest.ts",
    "parity:debounce": "tsx tools/parity/debounce-selftest.ts",
    "parity:shortcuts": "tsx tools/parity/shortcuts-selftest.ts",
    "parity:action-ids": "tsx --tsconfig tsconfig.web.json tools/parity/action-ids.ts",
    "css:dead": "tsx tools/css/dead-css.ts",
    "css:share": "tsx tools/css/share-css.ts",
    "parity:shortcuts-app": "tsx tools/parity/shortcuts-app-check.ts",
    "parity:drift": "tsx tools/parity/drift-check.ts",
    "parity:manual-ivs": "tsx tools/parity/manual-ivs-check.ts",
    "parity:art-layers": "tsx tools/parity/art-layers-check.ts",
    "parity:mock": "tsx tools/parity/mock-pokeabyte/cli.ts",
    "parity:scan": "tsx tools/parity/scan-fixture.ts",
    "parity:run": "tsx tools/parity/run.ts",
    "parity:diff": "tsx tools/parity/diff.ts",
    "parity:preflight": "tsx tools/parity/preflight.ts",
    "parity:adapter": "tsx tools/parity/adapter-selftest.ts",
    "parity:profile": "tsx tools/parity/profile-check.ts",
    "parity:all": "tsx tools/parity/verify-all.ts",
    "import:selftest": "tsx tools/import/selftest.ts",
    "import:dump": "tsx tools/import/dump-localstorage.ts",
    "packaged:probe": "tsx tools/parity/packaged-probe.ts",
    "cutter:describe": "tsx tools/cutter/describe.ts",
    "cutter:selftest": "tsx tools/cutter/selftest.ts"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@types/node": "^22.16.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/devtools": "^7.7.7",
    "electron": "^37.2.3",
    "electron-builder": "^26.0.12",
    "electron-devtools-installer": "^4.0.0",
    "electron-vite": "^4.0.0",
    "fast-xml-parser": "^5.11.1",
    "pixelmatch": "^7.2.0",
    "playwright-core": "^1.63.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.8.3",
    "vite": "^6.0.5",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vite-plugin-static-copy": "^3.1.1",
    "vite-plugin-vue-devtools": "^7.7.7",
    "vue": "^3.5.17",
    "vue-tsc": "^3.0.3",
    "ws": "^8.21.3"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@microsoft/signalr": "^7.0.14",
    "@vitejs/plugin-vue": "^6.0.0",
    "node-key-sender": "^1.0.11",
    "pinia": "^3.0.3",
    "pinia-plugin-watch": "^1.0.1",
    "uiohook-napi": "1.5.5",
    "vue": "^3.5.17"
  },
  "overrides": {
    "tar": "^7.5.13"
  }
}
