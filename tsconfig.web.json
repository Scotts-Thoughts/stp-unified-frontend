{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/env.d.ts",
    "src/renderer/**/*",
    "src/renderer/**/*.vue",
    "src/shared/**/*",
    "src/preload/*.d.ts",
    "damage-calc/src/**/*"
  ],
  "exclude": ["damage-calc/src/__tests__/**"],
  "compilerOptions": {
    "noEmit": true,
    "composite": true,
    "noUnusedLocals": false,  
    "noUnusedParameters": false,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "allowJs": true,
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "paths": {
      "~/*": [
        "src/renderer/*"
      ],
      "@stp/damage-calc": ["damage-calc/src/index.ts"],
      "@stp/damage-calc/*": ["damage-calc/src/*"]
    }
  }
}
